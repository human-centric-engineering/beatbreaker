{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatbreaker.app/schema/recording.schema.json",
  "title": "Recording",
  "description": "A track, album or video. Drum performances hold per-drummer detail so one recording can feature several drummers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "artist", "year", "drum_performances"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "year": {
      "$ref": "common.schema.json#/$defs/Year"
    },
    "type": {
      "enum": ["studio_track", "live_track", "album", "video", "film_soundtrack", "broadcast"]
    },
    "personnel": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/PersonRef"
      }
    },
    "producer": {
      "type": "string"
    },
    "style_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      }
    },
    "tempo_bpm": {
      "type": "number"
    },
    "time_signature": {
      "type": "string"
    },
    "feel": {
      "type": "string"
    },
    "studio_context": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "evidence": {
      "$ref": "common.schema.json#/$defs/Evidence"
    },
    "drum_performances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["drummer_id"],
        "properties": {
          "drummer_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "name": {
            "type": "string"
          },
          "drummer_role": {
            "enum": [
              "sole_drummer",
              "co_drummer",
              "drums_and_percussion",
              "percussion_only",
              "leader"
            ]
          },
          "significance": {
            "$ref": "common.schema.json#/$defs/Weight",
            "description": "Importance to the drummer's legacy."
          },
          "why_it_matters": {
            "type": "string"
          },
          "section_map": {
            "type": "array",
            "description": "What the drums do in each section.",
            "items": {
              "type": "object",
              "required": ["section"],
              "properties": {
                "section": {
                  "type": "string"
                },
                "timestamp": {
                  "$ref": "common.schema.json#/$defs/Timestamp"
                },
                "drum_approach": {
                  "type": "string"
                },
                "pattern_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/Id"
                  }
                }
              }
            }
          },
          "notable_moments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "timestamp": {
                  "$ref": "common.schema.json#/$defs/Timestamp"
                },
                "category": {
                  "enum": [
                    "groove",
                    "fill",
                    "solo",
                    "feel",
                    "dynamics",
                    "sound",
                    "interaction",
                    "arrangement",
                    "studio_story",
                    "technique"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "pattern_id": {
                  "$ref": "common.schema.json#/$defs/Id"
                },
                "evidence": {
                  "$ref": "common.schema.json#/$defs/Evidence"
                }
              }
            }
          },
          "kit_setup_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "pattern_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Id"
            }
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "description": "The songs on this recording picked for what the drumming does (Phase 15-b, D73), not every track.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "drummer_ids", "drums"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The song's title as released."
          },
          "artist": {
            "type": "string",
            "description": "The song's credited artist, where it is not the recording's."
          },
          "year": {
            "$ref": "common.schema.json#/$defs/Year",
            "description": "The song's release year, where it is not the recording's."
          },
          "drummer_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "description": "Who drums on it. Each has a drum_performance on the recording."
          },
          "drums": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "evidence"],
            "description": "One line on what the drums do, with a source.",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "$ref": "common.schema.json#/$defs/Evidence"
              }
            }
          },
          "transcriptions": {
            "type": "array",
            "description": "Human transcriptions known to exist. Empty or absent: none found.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["site"],
              "properties": {
                "site": {
                  "enum": ["songsterr", "drumeo", "hudson", "modern_drummer", "book", "other"]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "spotify": {
            "type": "string",
            "pattern": "^https://open\\.spotify\\.com/track/[A-Za-z0-9]{22}$",
            "description": "The track on Spotify, rebuilt from its id; passed the oEmbed check."
          },
          "youtube": {
            "type": "string",
            "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$",
            "description": "The song on YouTube, an official upload first; rebuilt from its id; passed the oEmbed check."
          },
          "style_key": {
            "type": "string",
            "description": "The catalogue style whose song plays it. With song_key, it is scored."
          },
          "song_key": {
            "type": "string",
            "description": "The key of the style's song that plays it (Style.songs)."
          },
          "also_song_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Other songs of the same style that play this one: a song the catalogue holds as several (Rime of the Ancient Mariner's parts). song_key is the one the table opens."
          }
        }
      }
    },
    "sampled_by": {
      "type": "array",
      "description": "Breakbeat and sampling legacy.",
      "items": {
        "type": "object",
        "required": ["artist"],
        "properties": {
          "artist": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "$ref": "common.schema.json#/$defs/Year"
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        }
      }
    },
    "later_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recording_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
