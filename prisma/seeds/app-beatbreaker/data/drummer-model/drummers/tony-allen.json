        }
      },
      {
        "name": "Snare clusters without a backbeat",
        "description": "Snare comes in short groups of hits and ghosts placed across the bar; in two of his five patterns beat 1 is the snare.",
        "weight": 0.9,
        "evidence": {
          "confidence": "verified",
          "source_ids": ["src:tony-allen-poitevin"]
        }
      }
    ],
    "foot_techniques": [
      {
        "name": "Hi-hat foot on every 'and'",
        "description": "The left foot chicks the hi-hat on the off-beat 8ths throughout, the fourth independent voice. He said his hi-hat does not stay closed.",
        "weight": 1.0,
        "evidence": {
          "confidence": "verified",
          "source_ids": ["src:tony-allen-poitevin", "src:tony-allen-research"]
        }
      },
      {
        "name": "Paired kicks",
        "description": "The kick comes in 16th-note pairs (1 and 1e, 3 and 3e) or floats off the beat; he avoided a plain 'one, one' on the bass drum.",
        "weight": 0.9,
        "evidence": {
          "confidence": "verified",
          "source_ids": ["src:tony-allen-poitevin", "src:tony-allen-research"]
        }
